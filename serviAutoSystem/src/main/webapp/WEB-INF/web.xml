<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

    <servlet>
        <servlet-name>ClienteServlet</servlet-name>
        <servlet-class>servlet.ClienteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClienteServlet</servlet-name>
        <url-pattern>/ClienteServlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>MenuServlet</servlet-name>
        <servlet-class>servlet.MenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/MenuServlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>VehiculoServlet</servlet-name>
        <servlet-class>servlet.VehiculoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehiculoServlet</servlet-name>
        <url-pattern>/VehiculoServlet</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>SeleccionAccionClienteServlet</servlet-name>
        <servlet-class>servlet.SeleccionAccionClienteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SeleccionAccionClienteServlet</servlet-name>
        <url-pattern>/SeleccionAccionClienteServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ModificarClienteServlet</servlet-name>
        <servlet-class>servlet.ModificarClienteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ModificarClienteServlet</servlet-name>
        <url-pattern>/ModificarClienteServlet</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>MenuServlet</welcome-file>
    </welcome-file-list>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
